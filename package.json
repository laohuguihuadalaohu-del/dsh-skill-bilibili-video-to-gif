{
  "name": "dsh-skill-bilibili-video-to-gif",
  "version": "0.1.0",
  "description": "DSH skill: turn Bilibili videos into GIF clips, bypassing the 412 anti-bot page and CDN 403.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "bilibili-video-to-gif"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "skill",
    "bilibili",
    "gif",
    "ffmpeg"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  }
}
